    "url": "https://github.com/fjlaubscher/rooivalk.git"
  },
  "homepage": "https://github.com/fjlaubscher/rooivalk",
  "keywords": [
    "discord",
    "bot",
    "openai",
    "typescript",
    "ai",
    "chatbot",
    "discord-bot",
    "weather",
    "image-generation"
  ],
  "engines": {
