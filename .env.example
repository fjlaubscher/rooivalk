DISCORD_STARTUP_CHANNEL_ID=channelidforstartup
DISCORD_MOTD_CHANNEL_ID=channelidformotd
DISCORD_TOKEN=discord_app_token
DISCORD_GUILD_ID=discord_server_id
DISCORD_APP_ID=discord_app_id
DISCORD_ALLOWED_APPS=comma,separated,app,ids
# Optional: restrict who can use the bot (messages + slash commands) to these
# Discord user IDs. Empty/unset means everyone in the guild may interact; DMs
# always fail closed and require the sender to be listed here. Grab IDs via
# Discord Settings > Advanced > Developer Mode, then right-click a user > Copy User ID.
DISCORD_ALLOWED_USERS=comma,separated,user,ids
OPENAI_API_KEY=openai_key
OPENAI_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-1
# Channel-specific behaviours (e.g. field hospital) are declared as profiles in
# config/profiles.json — copy config/profiles.example.json to get started.
ROOIVALK_MOTD_CRON="0 8 * * *"
ROOIVALK_LEADERBOARD_CRON="5 8 * * 3"
ROOIVALK_DB_PATH=./data/rooivalk.db
STEAM_API_KEY=your_steam_web_api_key
# Optional: Spotify Web API Client Credentials for lookup_spotify.
# Create a Web API app in the Spotify Developer Dashboard — no redirect URI needed.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Optional: fine-grained GitHub PAT with Issues read/write on the repos listed
# in GITHUB_REPOS (src/constants.ts). Enables the create/search issue tools.
GITHUB_TOKEN=your_github_personal_access_token
# Optional: set to "debug" to log prompt metrics (instruction/prompt lengths,
# attachment counts, previous_response_id presence) on every chat call.
LOG_LEVEL=info
